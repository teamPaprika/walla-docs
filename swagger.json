{
  "openapi": "3.0.0",
  "info": {
    "title": "Walla Open API",
    "version": "1.0"
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WALLA-API-KEY"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/open-api/v1/forms/{formId}/delivery": {
      "post": {
        "description": "본인이 권한을 가진 워크스페이스 내 특정 프로젝트(게시된 설문)를 수신인에게 발송합니다. 게시되지 않은 설문은 발송할 수 없습니다.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "폼 ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipients"
                ],
                "properties": {
                  "recipients": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "customerKey"
                      ],
                      "properties": {
                        "customerKey": {
                          "type": "string",
                          "description": "고객 식별 키"
                        },
                        "email": {
                          "type": "string",
                          "format": "email",
                          "description": "이메일 주소"
                        },
                        "phoneNumber": {
                          "type": "string",
                          "description": "전화번호"
                        }
                      }
                    }
                  },
                  "subject": {
                    "type": "string",
                    "description": "이메일 제목",
                    "default": "설문이 도착했습니다."
                  },
                  "message": {
                    "type": "string",
                    "description": "발송 메시지",
                    "default": "설문 링크를 확인하세요."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "발송 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "totalRecipients": {
                          "type": "number",
                          "description": "전체 수신자 수"
                        },
                        "successfulDeliveries": {
                          "type": "number",
                          "description": "성공한 발송 수"
                        },
                        "failedDeliveries": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "customerKey": {
                                "type": "string"
                              },
                              "email": {
                                "type": "string"
                              },
                              "phoneNumber": {
                                "type": "string"
                              },
                              "error": {
                                "type": "string"
                              }
                            }
                          },
                          "description": "실패한 발송 목록"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "인증 실패 또는 권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "폼을 찾을 수 없거나 게시되지 않은 설문",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 에러",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "description": "본인이 권한을 가진 워크스페이스 내 특정 프로젝트의 수신인들의 진행 상태 전체를 조회합니다.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "폼 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "수신인 목록 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "발송 ID"
                          },
                          "formId": {
                            "type": "string",
                            "description": "폼 ID"
                          },
                          "customerKey": {
                            "type": "string",
                            "description": "고객 식별 키"
                          },
                          "email": {
                            "type": "string",
                            "format": "email",
                            "description": "이메일 주소"
                          },
                          "phone": {
                            "type": "string",
                            "description": "전화번호"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "생성 일시"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "수정 일시"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "인증 실패 또는 권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "폼을 찾을 수 없거나 게시되지 않은 설문",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 에러",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/open-api/v1/forms/{formId}/delivery/status": {
      "post": {
        "description": "본인이 권한을 가진 워크스페이스 내 특정 프로젝트의 특정 수신인들의 진행 상태를 조회합니다.",
        "security": [
