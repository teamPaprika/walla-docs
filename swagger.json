                          },
                          "lastSentAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "마지막 발송 시간"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "생성 일시"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "수정 일시"
                          }
