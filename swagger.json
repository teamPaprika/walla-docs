    "/open-api/v1/forms/{formId}/responses/{responseId}": {
      "get": {
        "description": "본인이 권한을 가진 특정 폼의 특정 응답 상세 정보를 조회합니다",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "폼 ID"
          },
          {
            "in": "path",
            "name": "responseId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "응답 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "응답 정보 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "responseId": {
                          "type": "string",
                          "description": "응답 ID"
                        },
                        "formId": {
                          "type": "string",
                          "description": "폼 ID"
                        },
                        "teamId": {
                          "type": "string",
                          "description": "팀 ID"
                        },
                        "workspaceId": {
                          "type": "string",
                          "description": "워크스페이스 ID"
                        },
                        "response": {
                          "type": "object",
                          "description": "응답 데이터 (JSON)",
                          "additionalProperties": true
                        },
                        "submittedAt": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true,
                          "description": "제출일시"
                        },
                        "customerKey": {
                          "type": "string",
                          "nullable": true,
                          "description": "고객 키"
                        },
                        "startedAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "응답 시작일시"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "인증 실패 또는 권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "폼 또는 응답을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 에러",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/open-api/v1/forms/{formId}/responses": {
      "get": {
        "description": "본인이 권한을 가진 특정 폼(프로젝트)의 응답 목록을 페이지네이션하여 조회합니다",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "폼 ID"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "페이지 번호 (1부터 시작)"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "페이지당 응답 개수 (최대 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "응답 목록 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "responses": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "responseId": {
                                "type": "string",
                                "description": "응답 ID"
                              },
                              "customerKey": {
                                "type": "string",
                                "nullable": true,
                                "description": "고객 키"
                              },
                              "submittedAt": {
                                "type": "string",
                                "format": "date-time",
                                "description": "제출일시"
                              }
                            },
                            "additionalProperties": true,
                            "description": "응답 데이터 (폼 필드값들이 동적으로 포함됨)"
                          }
                        },
                        "pagination": {
                          "type": "object",
                          "properties": {
                            "page": {
                              "type": "integer",
                              "description": "현재 페이지 번호"
                            },
                            "limit": {
                              "type": "integer",
                              "description": "페이지당 응답 개수"
                            },
                            "totalCount": {
                              "type": "integer",
                              "description": "전체 응답 개수"
                            },
                            "totalPages": {
                              "type": "integer",
                              "description": "전체 페이지 수"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청 (유효하지 않은 페이지 번호 등)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "인증 실패 또는 권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "폼을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 에러",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
